# Allow only backend build inputs into the root Docker context.
**
!go.mod
!go.sum
!sqlc.yaml
!cmd/
!cmd/server/
!cmd/server/**
!internal/
!internal/**
!api/
!api/proto/
!api/proto/**
!migrations/
